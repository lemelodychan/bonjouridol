{
  "name": "bonjouridol-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "next lint",
    "slicemachine": "start-slicemachine",
    "clean": "rm -rf dist/*",
    "backup": "node scripts/backup-prismic.js",
    "backup:manual": "PRISMIC_ACCESS_TOKEN=$PRISMIC_ACCESS_TOKEN REPO_NAME=$REPO_NAME node scripts/backup-prismic.js",
    "backup:test": "node scripts/test-backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "backup:debug": "node scripts/debug-prismic.js",
    "backup:setup": "echo 'Creating .env file...' && cp env.example .env && echo '✅ .env file created! Please edit it with your actual values.'",
    "backfill:artists": "node scripts/backfill-artist-prismic.js",
    "backfill:article-artists": "node scripts/backfill-article-artists.js",
    "backfill:playlist-artists": "node scripts/backfill-playlist-artists.js",
    "backfill:all": "npm run backfill:artists && npm run backfill:article-artists && npm run backfill:playlist-artists",
    "fix:artists": "node scripts/fix-artist-prismic-uids.js"
  },
  "dependencies": {
    "@next/third-parties": "^15.1.4",
    "@prismicio/client": "^7.13.0",
    "@prismicio/migrate": "^0.0.2",
    "@prismicio/next": "^1.7.1",
    "@prismicio/react": "^2.9.1",
    "@supabase/supabase-js": "^2.54.0",
    "@tabler/icons-react": "^3.41.1",
    "@vercel/analytics": "^1.5.0",
    "archiver": "^6.0.1",
    "cheerio": "^1.2.0",
    "classnames": "^2.3.2",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "eslint": "8.47.0",
    "eslint-config-next": "13.4.13",
    "mini-css-extract-plugin": "^2.9.2",
    "next": "15.5.18",
    "next-share": "^0.27.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.35.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.14.0",
    "react-masonry-css": "^1.0.16",
    "recharts": "^3.7.0",
    "rss-parser": "^3.13.0",
    "swiper": "^12.1.4",
    "yet-another-react-lightbox": "^3.21.7"
  },
  "devDependencies": {
    "@slicemachine/adapter-next": "^0.3.59",
