  "format": "page",
  "repeatable": false,
  "status": true,
  "json": {
    "Main": {
      "venue_name_en": {
        "type": "Text",
        "config": {
          "label": "Venue name (EN)",
          "placeholder": "Nippori Neko Theater"
        }
      },
      "venue_name_ja": {
        "type": "Text",
        "config": {
          "label": "Venue name (JA)",
          "placeholder": "日暮里ねこシアター"
        }
      },
      "venue_sub_en": {
        "type": "Text",
        "config": {
          "label": "Venue sub-label (EN)",
          "placeholder": "Tokyo, Japan"
        }
      },
      "venue_sub_ja": {
        "type": "Text",
        "config": {
          "label": "Venue sub-label (JA)",
          "placeholder": "東京 / Tokyo"
        }
      },
      "event_date": {
        "type": "Date",
        "config": {
          "label": "Event date"
        }
      },
      "is_holiday": {
        "type": "Boolean",
        "config": {
          "label": "Public holiday",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "open_time": {
        "type": "Text",
        "config": {
          "label": "Open time",
          "placeholder": "12:00"
        }
      },
      "start_time": {
        "type": "Text",
        "config": {
          "label": "Start time",
          "placeholder": "12:20"
        }
      },
      "times_confirmed": {
        "type": "Boolean",
