          "label": "Times & prices confirmed",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": false
        }
      },
      "ticket_url": {
        "type": "Link",
        "config": {
          "label": "Ticket URL",
          "placeholder": "https://tickets.example.com/bonjour-party",
          "select": "web",
          "allowTargetBlank": true
        }
      },
      "ticket_tiers": {
        "type": "Group",
        "config": {
          "label": "Ticket tiers",
          "repeat": true,
          "fields": {
            "name_en": {
              "type": "Text",
              "config": {
                "label": "Tier name (EN)",
                "placeholder": "Front Area"
