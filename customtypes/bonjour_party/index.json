      "show_lineup": {
        "type": "Boolean",
        "config": {
          "label": "Show line-up",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
      },
      "show_timetable": {
        "type": "Boolean",
        "config": {
          "label": "Show timetable",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
      },
      "show_rules": {
        "type": "Boolean",
        "config": {
          "label": "Show rules",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
      },
      "show_about": {
        "type": "Boolean",
        "config": {
          "label": "Show about",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
      },
      "show_socials": {
        "type": "Boolean",
        "config": {
          "label": "Show socials",
          "placeholder_false": "false",
          "placeholder_true": "true",
          "default_value": true
        }
