            "note_en": {
              "type": "Text",
              "config": {
                "label": "Note (EN)",
                "placeholder": "Priority area, front-of-stage viewing"
              }
            },
            "note_ja": {
              "type": "Text",
              "config": {
                "label": "Note (JA)",
                "placeholder": "優先エリア確約・前方から観覧"
